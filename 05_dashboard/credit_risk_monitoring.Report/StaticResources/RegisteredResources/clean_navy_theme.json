{
  "name": "Clean Navy",
  "dataColors": [
    "#1F4E79",
    "#2F6FA8",
    "#5B9BD5",
    "#A9C6E8",
    "#F4B183",
    "#E07B39",
    "#C0392B",
    "#6B7280"
  ],
  "background": "#FFFFFF",
  "secondaryBackground": "#F4F6F9",
  "foreground": "#1F2933",
  "foregroundNeutralSecondary": "#6B7280",
  "tableAccent": "#1F4E79",
  "good": "#1F4E79",
  "neutral": "#F4B183",
  "bad": "#C0392B",
  "textClasses": {
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 14,
      "color": "#1F2933"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1F2933"
    },
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 28,
      "color": "#1F2933"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#6B7280"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F6F9"
              }
            }
          }
        ]
      }
    },
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E3E7ED"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1F2933"
              }
            },
            "fontFamily": "Segoe UI Semibold",
            "fontSize": 14
          }
        ],
        "subTitle": [
          {
            "fontColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontFamily": "Segoe UI",
            "fontSize": 11
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "valueAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ],
        "legend": [
          {
            "labelColor": {
              "solid": {
                "color": "#6B7280"
              }
            },
            "fontFamily": "Segoe UI"
          }
        ]
      }
    },
    "shape": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}